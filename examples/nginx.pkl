/// A minimal Nginx Compose deployment used by the integration test.
amends "../src/Compose.pkl"

services {
  ["nginx"] = new Service {
    // renovate: datasource=docker depName=nginx
    image = "nginx:1.27"
    labels = new Mapping { ["example.role"] = "web" }
    `env_file` = new Listing { "../examples/nginx.env" }
    ports = new Listing {
      new Port {
        published = 18080
        target = 80
      }
    }
  }
}
