/// A simple Nginx Docker Compose document used by the examples and integration test.
amends "../src/Compose.pkl"

services {
  ["nginx"] = new Service {
    // renovate: datasource=docker depName=nginx
    image = "nginx:1.27"
    ports = new Listing {
      new Port {
        published = 18080
        target = 80
      }
    }
  }
}
