/// A typed Docker Compose document backed by the official Compose JSON Schema.
open module pkldocker.Compose

import "schema/ComposeSpec.pkl" as Schema

// ── Compose file fields ──────────────────────────────────────────────────────

/// Services in this Compose application, keyed by service name.
services: Mapping<String(matches(Regex("^[a-zA-Z0-9._-]+$"))), Service> = new {}

@Deprecated
version: String? = null

/// Optional Compose project name.
name: String? = null

/// Sub-projects to include.
include: Listing<Schema.Include>? = null

/// Models used by this application.
models: Mapping<String(matches(Regex("^[a-zA-Z0-9._-]+$"))), Schema.Model>? = null

/// Optional top-level network definitions.
networks: Mapping<String(matches(Regex("^[a-zA-Z0-9._-]+$"))), Network>? = null

/// Optional top-level named volume definitions.
volumes: Mapping<String(matches(Regex("^[a-zA-Z0-9._-]+$"))), NamedVolume>? = null

/// Secrets shared by services.
secrets: Mapping<String(matches(Regex("^[a-zA-Z0-9._-]+$"))), Schema.Secret>? = null

/// Configurations shared by services.
configs: Mapping<String(matches(Regex("^[a-zA-Z0-9._-]+$"))), Schema.ItemConfig>? = null

/// Jobs that run to completion.
jobs: Mapping<String(matches(Regex("^[a-zA-Z0-9._-]+$"))), Schema.Job>? = null

// ── Top-level Compose types ──────────────────────────────────────────────────

/// A Docker Compose service definition, including all fields in the Compose schema.
typealias Service = Schema.Service

/// A structured host-to-container port mapping.
typealias Port = Schema.`[]Alternate2`

/// A structured service volume mount.
typealias Volume = Schema.`Volume[]Alternate1`

/// Container health-check configuration.
typealias Healthcheck = Schema.Healthcheck

/// A Compose network definition.
typealias Network = Schema.Network

/// A named Docker volume, optionally referring to an externally managed volume.
class NamedVolume {
  /// Optional Docker volume name when it differs from the Compose key.
  name: String? = null

  /// Whether the volume is managed outside this Compose project.
  `external`: Boolean = false
}

/// A service dependency condition.
typealias Dependency = Schema.DependsOnAlternate1

/// Container deployment resource settings.
typealias Deploy = Schema.Deployment

/// Docker resource settings.
typealias Resources = Schema.Resources

/// Docker resource reservations.
typealias Reservations = Schema.Reservations

/// A reserved host device.
typealias Device = Schema.Device

// ── YAML output ─────────────────────────────────────────────────────────────
output {
  value = new Dynamic {
    services = module.services
    networks = module.networks
    volumes = module.volumes
  }
  renderer = new YamlRenderer {}
}
