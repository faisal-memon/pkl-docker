  /// Limit write rate (bytes per second) to a device.
  device_write_bps: Listing<BlkioLimit>?

  /// Limit write rate (IO per second) to a device.
  device_write_iops: Listing<BlkioLimit>?

  /// Block IO weight (relative weight) for the service, between 10 and 1000.
  weight: (Int|String)?

  /// Block IO weight (relative weight) for specific devices.
  weight_device: Listing<BlkioWeight>?
}

